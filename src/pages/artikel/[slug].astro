---
import { env } from "cloudflare:workers";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getPublicPost } from "../../lib/content";

export const prerender = false;

const post = await getPublicPost(
  Astro.params.slug ?? "",
  (env as any).DB,
);

if (!post) {
  Astro.response.status = 404;
}
---

{post ? (
  <ArticleLayout {post} />
) : (
  <BaseLayout title="Artikel Tidak Ditemukan - AnekaNews" description="Halaman artikel yang Anda cari tidak dapat ditemukan.">
    <div style="max-width: 800px; margin: 6rem auto; padding: 0 1.5rem; text-align: center;">
      <h1 style="font-size: 3rem; color: #111; margin-bottom: 1rem; font-family: system-ui, -apple-system, sans-serif;">404 - Halaman Tidak Ditemukan</h1>
      <p style="font-size: 1.2rem; color: #555; margin-bottom: 2rem; font-family: system-ui, -apple-system, sans-serif;">Maaf, artikel yang Anda cari tidak tersedia atau telah dihapus.</p>
      <a href="/" style="display: inline-block; padding: 0.75rem 1.5rem; background-color: #14245f; color: white; text-decoration: none; border-radius: 4px; font-weight: bold; font-family: system-ui, -apple-system, sans-serif;">Kembali ke Beranda</a>
    </div>
  </BaseLayout>
)}

