---
import { env } from "cloudflare:workers";
import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Pagination from "../../components/Pagination.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getChannel } from "../../lib/channels";
import { getPublicPosts } from "../../lib/content";

let channel;
try {
  channel = getChannel(Astro.params.slug ?? "");
} catch {
  return Astro.redirect("/404");
}
const posts = await getPublicPosts((env as any).DB, channel.slug);
---

<BaseLayout title={channel.name} description={channel.description}>
  <div style="padding-top: 1.5rem;">
    <Breadcrumb items={[{ label: "Kanal" }, { label: channel.name }]} />
  </div>

  <header class="archive-heading">
    <span>Kanal Berita</span>
    <h1>{channel.name}</h1>
    <p>{channel.description}</p>
  </header>

  <section class="category-section" style="margin-top: 2rem;">
    <div class="grid-3col">
      {posts.map((post) => <ArticleCard {post} variant="grid" />)}
    </div>

    <!-- Pagination Navigation -->
    <Pagination currentPage={1} totalPages={2} baseUrl={`/kategori/${channel.slug}`} />
  </section>
</BaseLayout>
