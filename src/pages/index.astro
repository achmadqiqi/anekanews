---
import { env } from "cloudflare:workers";
import AdSlot from "../components/AdSlot.astro";
import ArticleCard from "../components/ArticleCard.astro";
import TopicChips from "../components/TopicChips.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CHANNELS } from "../lib/channels";
import { getPublicPosts } from "../lib/content";

const posts = await getPublicPosts((env as any).DB);

// Controlled Editorial Bento Hero Selection
const featured = posts[0];
const sideHighlights = posts.slice(1, 4);
const remainingPosts = posts.slice(4);

// Sort channel sections by editorial priority
const ORDERED_SLUGS = ["properti", "olahraga", "teknologi", "bisnis", "gaya-hidup"];
const orderedChannels = ORDERED_SLUGS.map((slug) =>
  CHANNELS.find((c) => c.slug === slug)
).filter((c): c is typeof CHANNELS[number] => Boolean(c));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AnekaNews",
  url: "https://anekanews.com",
  description: "Kabar hari ini & berita terkini seputar olahraga, teknologi, properti, bisnis, dan gaya hidup.",
};
---

<BaseLayout
  title="AnekaNews - Kabar Hari Ini & Berita Terkini"
  description="Beragam informasi tepercaya tentang rumah & properti, olahraga, teknologi, bisnis, dan gaya hidup."
  {jsonLd}
>
  <!-- Hero Section: Controlled Editorial Bento -->
  {featured && (
    <section class="hero-bento-section">
      <div class="main-container">
        <div class="bento-hero-grid">
          <!-- Main Story (65% width) -->
          <div class="bento-main-col">
            <ArticleCard post={featured} variant="bento-main" />
          </div>

          <!-- Side Highlights List (35% width) -->
          <div class="bento-side-col">
            <div class="side-col-header">
              <h3>SOROTAN PILLIAN REDAKSI</h3>
            </div>
            <div class="side-list-wrapper">
              {sideHighlights.map((post) => (
                <ArticleCard post={post} variant="bento-side" />
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Topic Chips Bar -->
  <TopicChips />

  <!-- Ad Space Placeholder (Hidden if AdSense is disabled) -->
  <div class="main-container">
    <AdSlot slotId="home-top-banner" format="horizontal" />
  </div>

  <!-- Category Block Sections (Ordered by Editorial Priority) -->
  <div class="main-container category-blocks-container">
    {orderedChannels.map((channel) => {
      const channelPosts = remainingPosts.filter(
        (p) =>
          p.channel.toLowerCase() === channel.name.toLowerCase() ||
          p.channel.toLowerCase() === channel.slug.toLowerCase()
      );

      if (channelPosts.length === 0) return null;

      const topHorizontal = channelPosts[0];
      const gridItems = channelPosts.slice(1, 4);

      return (
        <section class="category-block-section" id={channel.slug}>
          <div class="category-block-header">
            <h2>{channel.name}</h2>
            <a href={`/kategori/${channel.slug}`} class="cat-link-all">
              Lihat Semua {channel.name} ›
            </a>
          </div>

          {topHorizontal && (
            <ArticleCard post={topHorizontal} variant="horizontal" />
          )}

          {gridItems.length > 0 && (
            <div class="grid-3col">
              {gridItems.map((post) => (
                <ArticleCard post={post} variant="grid" />
              ))}
            </div>
          )}
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  /* Bento Hero Section */
  .hero-bento-section {
    padding: 1.5rem 0;
    background-color: var(--color-background);
  }
  .bento-hero-grid {
    display: grid;
    grid-template-columns: 65% 1fr;
    gap: 1.5rem;
    align-items: stretch;
  }
  .bento-side-col {
    display: flex;
    flex-direction: column;
  }
  .side-col-header {
    margin-bottom: 0.85rem;
  }
  .side-col-header h3 {
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
  }
  .side-list-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex: 1;
  }

  /* Category Block Sections */
  .category-blocks-container {
    padding: 2rem 1.25rem;
  }
  .category-block-section {
    margin-bottom: 3rem;
  }
  .category-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
  }
  .category-block-header h2 {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--color-primary);
    text-transform: uppercase;
  }
  .cat-link-all {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent);
    transition: color 0.15s ease;
  }
  .cat-link-all:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .bento-hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
