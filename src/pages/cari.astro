---
import { env } from "cloudflare:workers";
import ArticleCard from "../components/ArticleCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublicPosts } from "../lib/content";

const query = (Astro.url.searchParams.get("q") ?? "").trim();
const safeQuery = query.slice(0, 80);

const allPosts = await getPublicPosts((env as any).DB).catch(() => []);

const results = safeQuery.length >= 2
  ? allPosts.filter((post) =>
      `${post.title} ${post.excerpt} ${post.channel}`.toLocaleLowerCase("id-ID").includes(
        safeQuery.toLocaleLowerCase("id-ID"),
      ),
    )
  : [];
---

<BaseLayout title={`Hasil Pencarian: ${safeQuery || "Cari Berita"}`} description="Hasil pencarian artikel dan berita AnekaNews.">
  <div class="main-container search-page-wrapper">
    <header class="search-page-header">
      <span class="category-eyebrow">PENCARIAN ARTIKEL</span>
      <h1 class="search-page-title">Temukan Informasi Berita</h1>
      
      <form action="/cari" method="get" role="search" class="search-form-inline">
        <input
          type="search"
          name="q"
          value={safeQuery}
          placeholder="Ketik kata kunci pencarian..."
          minlength="2"
          maxlength="80"
          required
        />
        <button type="submit">Cari Berita</button>
      </form>
    </header>

    {safeQuery.length >= 2 && (
      <div class="search-results-meta">
        <p>Menampilkan <strong>{results.length}</strong> hasil untuk kata kunci <em>“{safeQuery}”</em></p>
      </div>
    )}

    {results.length > 0 ? (
      <div class="grid-3col">
        {results.map((post) => <ArticleCard {post} variant="grid" />)}
      </div>
    ) : safeQuery.length >= 2 ? (
      <div class="search-empty-state">
        <p>Tidak ditemukan artikel yang cocok dengan kata kunci “{safeQuery}”.</p>
      </div>
    ) : (
      <div class="search-empty-state">
        <p>Ketik kata kunci di atas untuk mencari artikel berita.</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .search-page-wrapper {
    padding: 2rem 1.25rem 4rem;
  }
  .search-page-header {
    margin-bottom: 2rem;
  }
  .search-page-title {
    font-size: 2rem;
    font-weight: 900;
    color: var(--color-primary);
    margin: 0.25rem 0 1.25rem;
  }
  .search-form-inline {
    display: flex;
    gap: 0.75rem;
    max-width: 600px;
  }
  .search-form-inline input {
    flex: 1;
    height: 48px;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.95rem;
  }
  .search-form-inline input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }
  .search-form-inline button {
    height: 48px;
    padding: 0 1.5rem;
    background-color: var(--color-accent);
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    cursor: pointer;
  }
  .search-form-inline button:hover {
    background-color: var(--color-accent-hover);
  }
  .search-results-meta {
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .search-empty-state {
    padding: 4rem 1rem;
    text-align: center;
    background-color: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
  }
  @media (max-width: 540px) {
    .search-form-inline {
      flex-direction: column;
    }
  }
</style>
