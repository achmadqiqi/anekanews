---
import CategoryNav from "./CategoryNav.astro";
import MobileMenu from "./MobileMenu.astro";
import SearchOverlay from "./SearchOverlay.astro";
import TerkiniBar from "./TerkiniBar.astro";
import UtilityBar from "./UtilityBar.astro";
---

<header class="site-header">
  <!-- Tier 1: Utility Bar -->
  <UtilityBar />

  <!-- Tier 2: Masthead -->
  <div class="masthead">
    <div class="main-container masthead-inner">
      <a href="/" class="brand-logo-link" aria-label="Beranda AnekaNews">
        <span class="brand-title">ANEKA<span>NEWS</span></span>
        <span class="brand-subtitle">Kabar Hari Ini & Berita Terkini</span>
      </a>

      <div class="masthead-actions">
        <button id="btn-trigger-search" class="btn-action-icon" aria-label="Buka Pencarian">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <button id="btn-trigger-hamburger" class="btn-action-icon btn-hamburger" aria-label="Buka Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Tier 3: Category Navigation Bar -->
  <CategoryNav />

  <!-- Information Bar: Terkini -->
  <TerkiniBar />

  <!-- Interactive Overlays & Drawers -->
  <SearchOverlay />
  <MobileMenu />
</header>

<style>
  .site-header {
    background-color: var(--color-background);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .masthead {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand-logo-link {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    font-size: 1.65rem;
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .brand-title span {
    color: var(--color-accent);
  }
  .brand-subtitle {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }
  .masthead-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .btn-action-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    cursor: pointer;
    color: var(--color-text);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn-action-icon:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .btn-hamburger {
    display: none;
  }
  @media (max-width: 860px) {
    .btn-hamburger {
      display: flex;
    }
  }
</style>

<script is:inline>
  document.getElementById("btn-trigger-search")?.addEventListener("click", function () {
    if (typeof window.openSearchModal === "function") {
      window.openSearchModal();
    }
  });

  document.getElementById("btn-trigger-hamburger")?.addEventListener("click", function () {
    const drawer = document.getElementById("mobile-menu-drawer");
    if (drawer) {
      drawer.classList.add("is-open");
      drawer.setAttribute("aria-hidden", "false");
      document.body.classList.add("menu-open");
    }
  });
</script>
