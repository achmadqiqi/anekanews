---
import { env } from "cloudflare:workers";
import { getPublicPosts } from "../lib/content";

const posts = await getPublicPosts((env as any).DB).catch(() => []);
const activePost = posts[0];
---

{activePost && (
  <div class="terkini-bar">
    <div class="main-container terkini-inner">
      <span class="terkini-badge">TERKINI</span>
      <a href={`/artikel/${activePost.slug}`} class="terkini-link">
        {activePost.title}
      </a>
    </div>
  </div>
)}

<style>
  .terkini-bar {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 0.5rem 0;
  }
  .terkini-inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    overflow: hidden;
  }
  .terkini-badge {
    background-color: var(--color-accent);
    color: #ffffff;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .terkini-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s ease;
  }
  .terkini-link:hover {
    color: var(--color-accent);
  }
</style>
