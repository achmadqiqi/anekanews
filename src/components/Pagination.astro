---
interface Props {
  currentPage?: number;
  totalPages?: number;
  baseUrl?: string;
}

const { currentPage = 1, totalPages = 3, baseUrl = "" } = Astro.props;
---

<nav class="pagination-container" aria-label="Navigasi Halaman Konten">
  <ul class="pagination-list">
    {currentPage > 1 ? (
      <li>
        <a href={`${baseUrl}?page=${currentPage - 1}`} class="pagination-btn">
          « Sebelumnya
        </a>
      </li>
    ) : (
      <li>
        <span class="pagination-btn disabled">« Sebelumnya</span>
      </li>
    )}

    {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
      <li>
        <a
          href={page === 1 ? (baseUrl || "/") : `${baseUrl}?page=${page}`}
          class={`pagination-num ${page === currentPage ? "active" : ""}`}
        >
          {page}
        </a>
      </li>
    ))}

    {currentPage < totalPages ? (
      <li>
        <a href={`${baseUrl}?page=${currentPage + 1}`} class="pagination-btn">
          Selanjutnya »
        </a>
      </li>
    ) : (
      <li>
        <span class="pagination-btn disabled">Selanjutnya »</span>
      </li>
    )}
  </ul>
</nav>
