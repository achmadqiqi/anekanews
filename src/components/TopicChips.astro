---
const TOPICS = [
  { label: "Rumah & Properti", slug: "properti" },
  { label: "Olahraga", slug: "olahraga" },
  { label: "Teknologi", slug: "teknologi" },
  { label: "Bisnis & UMKM", slug: "bisnis" },
  { label: "Gaya Hidup", slug: "lifestyle" },
  { label: "Kredit Usaha Rakyat (KUR)", slug: "bisnis" },
  { label: "AI Agent", slug: "teknologi" },
];
---

<div class="topic-chips-section">
  <div class="main-container">
    <div class="topic-chips-inner">
      <span class="topic-chips-label">Topik Pilihan:</span>
      <div class="topic-chips-list">
        {TOPICS.map((topic) => (
          <a href={`/kategori/${topic.slug}`} class="topic-chip">
            #{topic.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .topic-chips-section {
    padding: 0.85rem 0;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .topic-chips-inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .topic-chips-inner::-webkit-scrollbar {
    display: none;
  }
  .topic-chips-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }
  .topic-chips-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: nowrap;
  }
  .topic-chip {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    background: #ffffff;
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .topic-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: #ffffff;
  }
</style>
