---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SeoHead from "../components/SeoHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>;
}

const { title, description, type = "website", jsonLd } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <SeoHead {title} {description} {type} {jsonLd} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>AN</text></svg>" />
  </head>
  <body>
    <a class="skip-link" href="#content">Lewati ke isi</a>
    <div class="wrapper-boxed">
      <Header />
      <main id="content" class="main-container">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
